# Variables d'environnement du site Mana Prod
# Ce fichier liste les noms, sans aucune valeur. Les valeurs sont saisies par Ziza
# dans Vercel (Settings > Environment Variables), jamais dans le dépôt.
# Règle : une variable préfixée NEXT_PUBLIC_ est visible dans le navigateur.
# Aucune clé secrète ne porte ce préfixe.
# Le build réussit sans aucune de ces variables : une variable manquante lève
# une erreur claire à l'exécution, jamais à l'import.

# URL du projet Supabase (Supabase > Project Settings > API > Project URL).
# Public. Nécessaire à partir du Prompt 03 (création du projet Supabase).
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique anon de Supabase, lecture soumise aux policies RLS
# (Supabase > Project Settings > API > anon public).
# Public. Nécessaire à partir du Prompt 03 (création du projet Supabase).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role de Supabase (Supabase > Project Settings > API > service_role) :
# contourne la RLS. Seul usage : formulaire de contact (/api/contact), pour
# enregistrer les messages et limiter les envois. Sert aussi à dériver la clé
# de l'empreinte des adresses IP (aucune autre variable nécessaire).
# Serveur uniquement, jamais de préfixe NEXT_PUBLIC_, jamais dans un composant client.
# Nécessaire à partir du Prompt 07.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site : URL Vercel pendant le développement, puis https://manaprod.com.
# Sert aux métadonnées, au sitemap, aux images de partage et aux liens des emails.
# Public. Nécessaire à partir du Prompt 01.
NEXT_PUBLIC_SITE_URL=

# Clé d'API Resend pour l'envoi des emails (Resend > API Keys).
# Serveur uniquement. Nécessaire à partir du Prompt 07.
RESEND_API_KEY=

# Adresse qui reçoit les demandes du formulaire de contact.
# Serveur uniquement. Nécessaire à partir du Prompt 07.
CONTACT_TO_EMAIL=

# Adresse d'expédition des emails, sur un domaine vérifié dans Resend.
# Serveur uniquement. Nécessaire à partir du Prompt 07.
CONTACT_FROM_EMAIL=

# Secret qui protège la route /api/keepalive (envoyé par Vercel Cron dans
# l'en-tête Authorization). Chaîne aléatoire d'au moins 32 caractères.
# Serveur uniquement. Nécessaire à partir du Prompt 03.
CRON_SECRET=
